[Unit]
Description=The Glitch — worlds+data backup (no rebuildable jars, includes Oraxen.jar)
Documentation=https://github.com/TiraWeb/TheGlitch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/theglitch
# Repo is at /home/ubuntu/TheGlitch on this host; fallback handles other layouts
ExecStart=/bin/bash -c 'for r in /home/ubuntu/TheGlitch /home/minecraft/TheGlitch /opt/theglitch/TheGlitch; do if [ -x "$r/scripts/backup-now.sh" ]; then exec /bin/bash "$r/scripts/backup-now.sh"; fi; done; echo "No backup-now.sh found" >&2; exit 1'
StandardOutput=journal
StandardError=journal
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
